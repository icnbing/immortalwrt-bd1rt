/dts-v1/;

#include "rk3568.dtsi"

/ {
	compatible = "bendian,bd-one", "rockchip,rk3568";
	model = "BenDian One";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		mmc0 = &sdhci;
		led-boot = &power_led;
		led-failsafe = &power_led;
		led-running = &power_led;
		led-upgrade = &power_led;
	};

	cpuinfo {
		compatible = "rockchip,cpuinfo";
		nvmem-cells = <0x05 0x06 0x07>;
		nvmem-cell-names = "id", "cpu-version", "cpu-code";
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0x00>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <0x1b7740>;
		poll-interval = <0x64>;

		button-recovery {
			label = "Recovery";
			linux,code = <0x168>;
			press-threshold-microvolt = <0x6d6>;
		};
	};

	fan: gpio-fan {
		compatible = "gpio-fan";
		gpios = <&gpio4 0x07 0x00>;
		gpio-fan,speed-map = <0x00 0x00 0x1d4c 0x01>;
		#cooling-cells = <0x02>;
		pinctrl-0 = <&fan_pins>;
		pinctrl-names = "default";
	};

	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&power_led_pin>,<&status_led_pin>;

		power_led: led-0 {
			label = "red:power";
			gpios = <&gpio4 0x0b 0x01>;
		};

		led-1 {
			label = "green:status";
			gpios = <&gpio4 0x09 0x01>;
			linux,default-trigger = "heartbeat";
		};
	};

	hdmi-con {
		compatible = "hdmi-connector";
		type = "a";

		port {

			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	vcc12v_dcin: vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0xb71b00>;
		regulator-max-microvolt = <0xb71b00>;
		regulator-name = "vcc12v_dcin";
	};

	vcc3v3_sys: vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc3v3_pi6c_03: vcc3v3-pi6c-03 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio0 0x10 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&ssd_pwr_en>;
		regulator-name = "vcc3v3_pi6c_03";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc3v3_pcie: vcc3v3-pcie {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <&vcc3v3_pi6c_03>;
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_usb: vcc5v0-usb {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 0x11 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_pwr_en>;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-name = "vcc5v0_usb";
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <&vcc3v3_sys>;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <&vcc3v3_sys>;
	};

	vcca_1v8: vcca-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcca_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <&vcc3v3_sys>;
	};

	vdda_0v9: vdda-0v9 {
		compatible = "regulator-fixed";
		regulator-name = "vdda_0v9";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0xdbba0>;
		regulator-max-microvolt = <0xdbba0>;
		vin-supply = <&vcc3v3_sys>;
	};

	vdd_gpu: vdd-gpu {
		compatible = "pwm-regulator";
		pwms = <&pwm4 0x00 0x1388 0x01>;
		pwm-supply = <&vcc3v3_sys>;
		regulator-name = "vdd_gpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-init-microvolt = <0xdbba0>;
		regulator-min-microvolt = "", "\f5";
		regulator-max-microvolt = <0x149970>;
		regulator-ramp-delay = <0x1771>;
		regulator-settling-time-up-us = <0xfa>;
	};

	vdd_logic: vdd-logic {
		compatible = "pwm-regulator";
		pwms = <&pwm5 0x00 0x1388 0x01>;
		pwm-supply = <&vcc3v3_sys>;
		regulator-name = "vdd_logic";
		regulator-always-on;
		regulator-boot-on;
		regulator-init-microvolt = <0xdbba0>;
		regulator-min-microvolt = <0x7a120>;
		regulator-max-microvolt = <0x149970>;
		regulator-ramp-delay = <0x1771>;
		regulator-settling-time-up-us = <0xfa>;
	};
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
};

&gpu {
	status = "okay";
	mali-supply = <&vdd_gpu>;
};

&hdmi_sound {
	status = "okay";
};

&usb_host0_xhci {
	status = "okay";
	phys = <&usb2phy0_otg>,<&combphy0 0x04>;
	phy-names = "usb2-phy", "usb3-phy";
	extcon = <&usb2phy0>;
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&pmu_io_domains {
	status = "okay";
	pmuio1-supply = <&vcc_3v3>;
	pmuio2-supply = <&vcc_3v3>;
	vccio1-supply = <&vcc_3v3>;
	vccio2-supply = <&vcc_1v8>;
	vccio3-supply = <&vcc_3v3>;
	vccio4-supply = <&vcc_3v3>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_3v3>;
	vccio7-supply = <&vcc_3v3>;
};

&i2c0 {
	status = "okay";

	vdd_cpu: regulator@1c {
		compatible = "tcs,tcs4525";
		reg = <0x1c>;
		fcs,suspend-voltage-selector = <0x01>;
		regulator-name = "vdd_cpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-init-microvolt = <0xdbba0>;
		regulator-min-microvolt = <0xadf34>;
		regulator-max-microvolt = <0x1535b0>;
		regulator-ramp-delay = <0x8fc>;
		vin-supply = <&vcc3v3_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&gmac0 {
	status = "okay";
	assigned-clocks = <&cru 0x185>,<&cru 0x182>;
	assigned-clock-parents = <&cru 0x183>;
	assigned-clock-rates = <0x00 0x7735940>;
	clock_in_out = "output";
	phy-mode = "rgmii";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim>,<&gmac0_tx_bus2>,<&gmac0_rx_bus2>,<&gmac0_rgmii_clk>,<&gmac0_rgmii_bus>;
	tx_delay = <0x4f>;
	rx_delay = <0x0f>;

	fixed-link {
		speed = <0x3e8>;
		full-duplex;
	};
};

&mdio0 {

	switch@29 {
		compatible = "realtek,rtl8365mb";
		reg = <0x1d>;
		reset-gpios = <&gpio0 0x03 0x01>;

		switch_intc: interrupt-controller {
			interrupt-parent = <&gpio0>;
			interrupts = <0x04 0x08>;
			interrupt-controller;
			#address-cells = <0x00>;
			#interrupt-cells = <0x01>;
		};

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;
				label = "lan4";
			};

			port@1 {
				reg = <0x01>;
				label = "lan3";
			};

			port@2 {
				reg = <0x02>;
				label = "lan2";
			};

			port@3 {
				reg = <0x03>;
				label = "lan1";
			};

			port@7 {
				reg = <0x07>;
				label = "cpu";
				ethernet = <&gmac0>;
				phy-mode = "rgmii";

				fixed-link {
					speed = <0x3e8>;
					full-duplex;
				};
			};
		};
	};
};

&gmac1 {
	status = "okay";
	assigned-clocks = <&cru 0x189>,<&cru 0x186>;
	assigned-clock-parents = <&cru 0x187>;
	assigned-clock-rates = <0x00 0x7735940>;
	clock_in_out = "output";
	phy-handle = <0x49>;
	phy-mode = "rgmii";
	phy-supply = <&vcc_3v3>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1m0_miim>,<&gmac1m0_tx_bus2>,<&gmac1m0_rx_bus2>,<&gmac1m0_rgmii_clk>,<&gmac1m0_rgmii_bus>;
	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
	snps,reset-gpio = <&gpio1 0x06 0x01>;
	snps,reset-active-low;
	tx_delay = <0x30>;
	rx_delay = <0x10>;
};

&mdio1 {
	
	phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x00>;
		realtek,led-data = <0x17b>;
	};
};


&vop {
	status = "okay";
	compatible = "rockchip,rk3568-vop";
	assigned-clocks = <&cru 0xdf>,<&cru 0xe0>;
	assigned-clock-parents = <&pmucru 0x02>,<&cru 0x05>;
};

&vp0 {

	vp0_out_hdmi: endpoint@2 {
		reg = <0x02>;
		remote-endpoint = <&hdmi_in_vp0>;
	};
};

&vop_mmu {
	status = "okay";
};

&hdmi {
	status = "okay";
	avdd-0v9-supply = <&vdda_0v9>;
	avdd-1v8-supply = <&vcca_1v8>;

	ports {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		hdmi_in: port@0 {
			reg = <0x00>;

			hdmi_in_vp0: endpoint {
				remote-endpoint = <&vp0_out_hdmi>;
			};
		};

		hdmi_out: port@1 {
			reg = <0x01>;

			hdmi_out_con: endpoint {
				remote-endpoint = <&hdmi_con_in>;
			};
		};
	};
};

&pcie2x1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pcie20_reset_pin>;
	reset-gpios = <&gpio3 0x11 0x00>;
	vpcie3v3-supply = <&vcc3v3_sys>;
};

&sdhci {
	status = "okay";
	bus-width = <0x08>;
	max-frequency = <0xbebc200>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8>,<&emmc_clk>,<&emmc_cmd>;
};

&i2s0_8ch {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&cpu_thermal {

	trips {

		cpu_alert0: cpu_alert0 {
			temperature = <0x11170>;
			hysteresis = <0x7d0>;
			type = "passive";
		};

		cpu_alert1: cpu_alert1 {
			temperature = <0x124f8>;
			hysteresis = <0x7d0>;
			type = "passive";
		};

		cpu_crit: cpu_crit {
			temperature = <0x17318>;
			hysteresis = <0x7d0>;
			type = "critical";
		};

		cpu_trip_active_low: cpu-trip-active-low {
			temperature = <0xd6d8>;
			hysteresis = <0x7d0>;
			type = "active";
		};

		cpu_trip_active_med: cpu-trip-active-med {
			temperature = <0x11170>;
			hysteresis = <0x7d0>;
			type = "active";
		};

		cpu_trip_active_high: cpu-trip-active-high {
			temperature = <0x14c08>;
			hysteresis = <0x7d0>;
			type = "hot";
		};
	};

	cooling-maps {

		map0 {
			trip = <&cpu_alert0>;
			cooling-device =
				<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
				<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
				<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
				<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};

		cpu-active-low {
			cooling-device = <&fan 0x01 0x01>;
			trip = <&cpu_trip_active_low>;
		};

		cpu-active-med {
			cooling-device = <&fan 0x01 0x01>;
			trip = <&cpu_trip_active_med>;
		};

		cpu-active-high {
			cooling-device = <&fan 0x01 0x01>;
			trip = <&cpu_trip_active_high>;
		};
	};
};

&tsadc {
	status = "okay";
	rockchip,hw-tshut-mode = <0x01>;
	rockchip,hw-tshut-polarity = <0x00>;
};

&saradc {
	status = "okay";
	vref-supply = <&vcca_1v8>;
};

&pwm4 {
	status = "okay";
};

&pwm5 {
	status = "okay";
};

&combphy1 {
	status = "okay";
};

&combphy2 {
	status = "okay";
};

&usb2phy0 {
	status = "okay";

	usb2phy0_host: host-port {
		#phy-cells = <0x00>;
		status = "okay";
		phy-supply = <&vcc5v0_usb>;
	};

	usb2phy0_otg: otg-port {
		#phy-cells = <0x00>;
		status = "okay";
		phy-supply = <&vcc5v0_usb>;
	};
};

&sata0 {
	status = "okay";
};

&sata1 {
	status = "okay";
};

&pcie30phy {
	status = "okay";
};

&pcie3x2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30_reset_pin>;
	reset-gpios = <&gpio0 0x16 0x00>;
	vpcie3v3-supply = <&vcc3v3_pcie>;
};

&crypto {
	status = "okay";
};

&combphy0 {
	status = "okay";
};